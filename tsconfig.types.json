{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node"
        ],
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "lib",
        "rootDir": "src",
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts"
    ]
}
