{
    "name": "@yuhere/js-zip",
    "type": "module",
    "description": "utility library for reading and writing zip files in browser.",
    "version": "2.8.26",
    "publisher": "yuhere",
    "repository": "https://github.com/yuhere/js-zip.git",
    "license": "MIT",
    "main": "lib/index.js",
    "module": "lib/index.js",
    "files": [
        "lib",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "vite build",
        "dev:docs": "npx serve docs",
        "test": "vitest run --config vitest.node.config.js",
        "test:node": "vitest run --config vitest.node.config.js",
        "test:browser": "vitest --config vitest.browser.config.js",
        "test:coverage": "vitest run --config vitest.node.config.js --coverage && vitest run --config vitest.browser.config.js --coverage && node scripts/coverage-merge.js",
        "test:watch": "vitest --config vitest.node.config.js",
        "prepublishOnly": "npm run build && npm run test:coverage && node scripts/generate-badge.js"
    },
    "devDependencies": {
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "istanbul-lib-coverage": "^3.2.2",
        "istanbul-lib-report": "^3.0.1",
        "istanbul-reports": "^3.2.0",
        "playwright": "^1.62.1",
        "vite": "^7.2.6",
        "vitest": "^4.0.15"
    }
}
