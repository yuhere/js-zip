{
    "name": "@yuhere/js-zip",
    "type": "module",
    "description": "utility library for reading and writing zip files in browser.",
    "version": "1.0.0",
    "publisher": "yuhere",
    "repository": "https://github.com/yuhere/js-zip.git",
    "license": "MIT",
    "main": "lib/index.js",
    "module": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "bin/",
        "lib/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "npm-run-all -p build:*",
        "build:rollup": "rollup --config rollup.config.js",
        "lint": "eslint src",
        "test": "npm run build && npx c8 node ./tests/node-runner.js",
        "test-deno": "cd ./tests && deno test --allow-read ./deno-runner.js",
        "test-node": "npm run build && npx c8 node ./tests/node-runner.js",
        "test-bun": "cd ./tests && bun test ./bun-runner.js",
        "test-firefox": "firefox http://localhost:8081/tests/ & npx http-server -p=8081 & wait $!",
        "test-chrome": "google-chrome http://localhost:8081/tests/ & npx http-server -p=8081 & wait $!"
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.6.1",
        "@typescript-eslint/eslint-plugin": "^7.14.1",
        "@typescript-eslint/parser": "^7.11.0",
        "c8": "^10.1.3",
        "chai": "^4.3.7",
        "eslint": "^8.57.0",
        "mocha": "^10.2.0",
        "npm-run-all": "^4.1.5",
        "rollup": "^4.53.3",
        "rollup-plugin-esbuild": "^6.2.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}